{
  "info": {
    "name": "Smoke Postman",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [{ "key": "orderId", "value": "7" }],
  "item": [
    {
      "name": "Orders",
      "item": [
        {
          "name": "List orders",
          "request": {
            "method": "GET",
            "header": [{ "key": "X-Source", "value": "postman" }],
            "url": { "raw": "{{baseUrl}}/pm/orders?page=1", "query": [{ "key": "page", "value": "1" }] }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('ok', () => pm.response.to.have.status(200));"] } }]
        },
        {
          "name": "Get order",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/pm/orders/:orderId", "variable": [{ "key": "orderId", "value": "7" }] } }
        }
      ]
    },
    {
      "name": "Create order",
      "request": {
        "method": "POST",
        "body": { "mode": "raw", "raw": "{\"sku\":\"A-1\"}", "options": { "raw": { "language": "json" } } },
        "url": "{{baseUrl}}/pm/orders"
      }
    }
  ]
}
