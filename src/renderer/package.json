{
  "name": "@quiver/renderer",
  "version": "0.1.0",
  "private": true,
  "description": "The Quiver renderer: the Angular application that draws the shell and hosts every module's UI. Talks to the host only through commands.",
  "scripts": {
    "start": "ng serve",
    "build": "ng build",
    "typecheck": "ngc -p tsconfig.app.json --noEmit"
  },
  "dependencies": {
    "@angular/common": "^22.2.1",
    "@angular/compiler": "^22.2.1",
    "@angular/core": "^22.2.1",
    "@angular/forms": "^22.2.1",
    "@angular/platform-browser": "^22.2.1",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.1",
    "@angular/cli": "^22.2.1",
    "@angular/compiler-cli": "^22.2.1",
    "@tailwindcss/postcss": "^4.3.3",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3"
  }
}
